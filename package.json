{
  "name": "seq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser MIDI step sequencer with a worker-driven clock.",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@nonchalant/core": "link:../nonchalant/packages/core",
    "@nonchalant/dom": "link:../nonchalant/packages/dom",
    "@nonchalant/wire": "link:../nonchalant/packages/wire"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
